{
  "manifest_version": 3,
  "name": "Google Reviews CSV Exporter",
  "description": "Export loaded Google Maps reviews to CSV or JSON with accumulated auto-scroll capture.",
  "version": "0.2.0",
  "action": {
    "default_title": "Export Google Reviews",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*",
    "https://www.google.com.tr/maps/*",
    "https://www.google.co.uk/maps/*",
    "https://www.google.ca/maps/*",
    "https://www.google.com.au/maps/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*",
        "https://www.google.com.tr/maps/*",
        "https://www.google.co.uk/maps/*",
        "https://www.google.ca/maps/*",
        "https://www.google.com.au/maps/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
